#!/bin/sh
#
# PROVIDE: tayga-managed
# REQUIRE: NETWORKING DAEMON tayga-recovery
# BEFORE: LOGIN
# KEYWORD: shutdown

case ":${PATH:-}:" in *:/usr/local/sbin:*) ;; *) PATH="${PATH:-/sbin:/bin:/usr/sbin:/usr/bin}:/usr/local/sbin:/usr/local/bin"; export PATH ;; esac

. /etc/rc.subr

name="tayga_managed"
rcvar="tayga_managed_enable"

load_rc_config $name

: ${tayga_managed_enable:="NO"}
: ${tayga_managed_profile:="nat64"}

profile=${tayga_managed_profile}
pidfile="/var/run/tayga-managed-${profile}.pid"
command="/usr/sbin/daemon"
# The pidfile holds the daemon(8) supervisor, which restarts the runner after any
# exit (the rc.d counterpart of systemd Restart=).
procname="/usr/sbin/daemon"
rcscript="/usr/local/etc/rc.d/tayga-managed"
extra_commands="runner"
runner_cmd="tayga_runner"
command_args="-r -R 3 -P ${pidfile} /bin/sh ${rcscript} onerunner"

start_precmd="tayga_start_pre"
start_postcmd="tayga_start_post"
stop_postcmd="tayga_stop_post"

tayga_start_pre() {
    case "$profile" in clat|nat64|siit) ;; *) err 1 "Invalid managed profile: $profile" ;; esac
    mkdir -p "/var/lib/tayga" "/var/lib/tayga/${profile}" "/var/run/tayga-managed-${profile}"
    chmod 0750 "/var/lib/tayga" "/var/lib/tayga/${profile}" "/var/run/tayga-managed-${profile}"
    # An explicit start (installer, rollback, administrator) gets a fresh restart budget.
    rm -f "/var/run/tayga-managed-${profile}/starts"
    if [ -x /usr/local/libexec/tayga/tayga-dns64 ]; then
        /usr/local/libexec/tayga/tayga-dns64 prepare "/etc/tayga/${profile}.conf" || return 1
    fi
    if [ -x /usr/local/libexec/tayga/tayga-host-dns ]; then
        /usr/local/libexec/tayga/tayga-host-dns prepare "/etc/tayga/${profile}.conf" || return 1
    fi
}

tayga_start_post() {
    dev=$(awk '$1=="tun-device" {print $2; exit}' "/etc/tayga/${profile}.conf")
    n=0
    until ifconfig "$dev" 2>/dev/null | grep -q 'flags=.*<.*\bUP\b' && pgrep -x tayga >/dev/null; do
        n=$((n + 1)); [ "$n" -le 60 ] || break
        sleep 1
    done
    if ! /usr/local/libexec/tayga/tayga-verify "/etc/tayga/${profile}.conf"; then
        if [ -f "$pidfile" ]; then kill -TERM "$(cat "$pidfile")" 2>/dev/null || :; fi
        if [ -x /usr/local/libexec/tayga/tayga-dns64 ]; then
            /usr/local/libexec/tayga/tayga-dns64 down "/etc/tayga/${profile}.conf" || :
        fi
        if [ -x /usr/local/libexec/tayga/tayga-host-dns ]; then
            /usr/local/libexec/tayga/tayga-host-dns down "/etc/tayga/${profile}.conf" || :
        fi
        /usr/local/libexec/tayga/tayga-net-ctl down "/etc/tayga/${profile}.conf"
        return 1
    fi
}

tayga_stop_post() {
    if [ -x /usr/local/libexec/tayga/tayga-dns64 ]; then
        /usr/local/libexec/tayga/tayga-dns64 down "/etc/tayga/${profile}.conf" || :
    fi
    if [ -x /usr/local/libexec/tayga/tayga-host-dns ]; then
        /usr/local/libexec/tayga/tayga-host-dns down "/etc/tayga/${profile}.conf" || :
    fi
    /usr/local/libexec/tayga/tayga-net-ctl down "/etc/tayga/${profile}.conf"
}

# Runs under daemon(8): rebuild the owned network state before every (re)start,
# because FreeBSD drops the addresses and UP flag of a tun(4) whose process died.
# After 5 starts within 120 s give up so tayga-recovery can take over.
tayga_runner() {
    config="/etc/tayga/${profile}.conf"
    net=/usr/local/libexec/tayga/tayga-net-ctl
    starts="/var/run/tayga-managed-${profile}/starts"
    now=$(date +%s)
    recent=$(awk -v n="$now" '$1 > n - 120' "$starts" 2>/dev/null || :)
    if [ -n "$recent" ] && [ "$(printf '%s\n' "$recent" | wc -l)" -ge 5 ]; then
        echo "tayga-managed: restart limit reached, stopping" >&2
        "$net" down "$config" || :
        kill -TERM "$PPID"
        exit 0
    fi
    { [ -z "$recent" ] || printf '%s\n' "$recent"; echo "$now"; } > "$starts"
    "$net" down "$config" || :
    "$net" up "$config" || exit 1
    exec /usr/local/sbin/pref64-discover --supervise-ra "$config" --network-controller "$net" -- /usr/local/sbin/tayga --config "$config" --runtime-dir "/var/run/tayga-managed-${profile}" --nodetach
}

run_rc_command "$@"
