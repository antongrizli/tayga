[Unit]
Description=Recover interrupted TAYGA activation before network services
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/tayga/tayga-boot-recover.sh
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=sysinit.target
