config service 'main'
	option enabled '0'
	option config '/etc/tayga/managed.conf'
	# Use managed only with the optional network package; external uses prepared networking.
	option network_mode 'external'
	# Optional logical netifd interface, e.g. wan6. Empty disables WAN tracking.
	option uplink ''
	# Managed CLAT/NAT64/SIIT uses this logical client-side interface.
	option inside 'lan'
	# Optional readiness target (IPv4 or IPv6) probed on managed startup/reload.
	option verify_target ''
